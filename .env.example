# CoinMarketCap API key (required — crypto pricing is always on)
API_KEY=your_coinmarketcap_api_key

# brapi.dev API key (optional — only needed once a br-equities asset, e.g.
# HGRU11/XPML11, is tracked in the portfolio). Free tier: https://brapi.dev
BRAPI_API_KEY=your_brapi_api_key

# Finnhub API key (optional — only needed once a us-indices asset is
# tracked). Free tier: https://finnhub.io
FINNHUB_API_KEY=your_finnhub_api_key

# Which BARCA market profile to use ("BullMarket" or "BearMarket") — every
# barca_targets row belongs to exactly one profile, with no cross-market
# fallback, so a non-crypto barca like "IBOVE" needs its own row in each
# profile it should be active under.
CURRENT_MARKET=BullMarket

DATABASE_URL=sqlite://./data/crypto.db

# --- Authentication ---

# Required. Signs/verifies JWT access tokens. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_char_hex_string

# Bootstrap admin, created once on first boot if the users table is empty.
# There is no public sign-up endpoint — every other account is created by
# this admin via the Admin tab.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
ADMIN_EMAIL=admin@example.com

# Must match the frontend's origin exactly — the browser rejects
# cookie-carrying cross-origin requests against a wildcard origin.
FRONTEND_ORIGIN=http://localhost:5173

# Set to true once served over HTTPS (production). Browsers silently drop
# `Secure` cookies over plain HTTP, so keep this false for local dev.
COOKIE_SECURE=false
