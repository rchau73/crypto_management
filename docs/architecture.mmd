flowchart TD
    subgraph MAIN["Composition Root — src/main.rs"]
        H1["Axum HTTP handlers\n(api_allocations, api_history, import_wallets_handler)"]
    end

    subgraph AUTHMOD["src/auth_handlers.rs — auth & admin HTTP glue"]
        CU["CurrentUser extractor\n(verifies access_token cookie)"]
        AH["/api/auth/* handlers\n(login, logout, refresh, me)"]
        ADMH["/api/admin/users* handlers\n(require_role(Admin))"]
    end

    subgraph USECASES["src/usecases/ — business logic"]
        CA["compute_allocations\n(pure function, no I/O)"]
        AS["AllocationsService"]
        HS["HistoryService"]
        AUS["AuthService\n(argon2 verify, JWT issue/verify)"]
        US["UserService\n(admin CRUD on users)"]
    end

    subgraph DOMAIN["src/domain/ — models & ports"]
        MODELS["models.rs\nCrypto, WalletAllocation, User, Role, snapshot rows"]
        REPO_PORT["repository.rs\nHistoryRepo, UserRepo, RefreshTokenRepo traits"]
        MD_PORT["market_data.rs\nCryptoProvider trait"]
    end

    subgraph INFRA["src/infra/ — adapters"]
        SQLITE["sqlite/repo.rs\nSqliteRepo\n(implements all 3 repo traits)"]
        CMC["coinmarketcap.rs\nReqwestCryptoProvider"]
    end

    H1 -->|requires| CU
    H1 -->|calls| AS
    H1 -->|calls| HS
    AH -->|calls| AUS
    ADMH -->|calls| US
    CU -->|verifies via| AUS
    AS -->|calls| CA
    AS -->|depends on| MD_PORT
    AS -->|depends on| REPO_PORT
    HS -->|depends on| REPO_PORT
    AUS -->|depends on| REPO_PORT
    US -->|depends on| REPO_PORT
    CA -->|uses| MODELS

    SQLITE -.->|implements| REPO_PORT
    CMC -.->|implements| MD_PORT

    MAIN -->|constructs & injects| SQLITE
    MAIN -->|constructs & injects| CMC
    MAIN -->|mounts| AUTHMOD

