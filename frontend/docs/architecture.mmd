flowchart TD
    subgraph APP["App.jsx — composition root"]
        ROOT["Renders LoginPage while logged out;\nonce logged in, PortfolioGate → Dashboard:\npage from the URL hash, side menu + page"]
    end

    subgraph AUTHUI["Auth UI"]
        LOGIN["LoginPage\n(full-page swap when logged out)"]
    end

    subgraph LAYOUT["Layout components"]
        HEADER["AppHeader (sticky)\nPortfolioSwitcher · GlobalSearch (Ctrl/⌘K)\nPricesAge · ActionsBar · Log Out"]
        NAV["SideNav\n(column on wide screens, drawer on phones)"]
        STATS["StatTiles"]
        STATUS["StatusLine"]
        EMPTY["EmptyState"]
    end

    subgraph TABS["components/tabs/ — one per page"]
        TR["RebalanceTab (start page)\nSentimentPicker · BarcaBands · RoundSteps"]
        T0["HoldingsTab\n(View by position · asset · group · BARCA)"]
        T1["DashboardTab\n(History)"]
        T2["TargetsTab → PortfolioTargetsTab,\nBarcaTargetsTab (can edit)"]
        T3["SettingsTab → AccountsTab,\nAdminTab (admin)"]
    end

    subgraph SHARED["Shared UI components"]
        SORTHEAD["SortableTableHead"]
        SUBTABS["SubTabs"]
        BADGE["DeviationBadge\n(status dot + text)"]
        LINE["HistoryLineChart"]
        TOOLTIP["ChartTooltip"]
        DCTRL["DashboardControls"]
    end

    subgraph HOOKS["hooks/ — state & data fetching"]
        HAUTH["useAuth\n(session check, login, logout)"]
        HALLOC["useAllocations"]
        HHIST["useHistoryDashboard"]
        HUSERS["useUsers\n(admin CRUD)"]
        HSORT["useSortableData"]
        HROUTE["useHashRoute\n(page + params in the URL)"]
    end

    subgraph UTILS["utils/ — pure functions (unit tested)"]
        FMT["formatters.js · time.js"]
        MATH["allocationMath.js\n(BARCA band)"]
        HOLD["holdings.js\n(rows per view)"]
        REB["rebalance.js\n(round planner, BARCA rules)"]
        NAVU["navigation.js · route.js · search.js"]
        BUCKET["historyBucketing.js"]
    end

    subgraph API["api/client.js"]
        CLIENT["fetchAllocations() · fetchHistory() · importWallets()\nlogin() · logout() · fetchCurrentUser()\nfetchUsers() · createUser() · updateUser() · deleteUser()\n(every call: credentials: include + silent refresh-on-401)"]
    end

    THEME["theme.js\ndarkTheme · COLORS · colorForSeries"]
    BACKEND[("Rust backend\nGET/POST /api/*")]

    ROOT -->|owns| HAUTH
    ROOT -->|logged out| LOGIN
    ROOT -->|logged in| HEADER
    ROOT --> NAV
    ROOT --> STATS
    ROOT --> STATUS
    ROOT --> EMPTY
    ROOT -->|page = rebalance| TR
    ROOT -->|page = holdings| T0
    ROOT -->|page = history| T1
    ROOT -->|page = targets| T2
    ROOT -->|page = settings| T3
    ROOT -->|owns| HALLOC
    ROOT -->|owns| HROUTE

    LOGIN -->|calls| HAUTH
    T3 -->|owns| HUSERS

    TABS --> SHARED
    TABS --> HOOKS
    TABS --> UTILS
    HOOKS --> CLIENT
    CLIENT --> BACKEND
    TABS -.->|theme tokens| THEME
    SHARED -.->|theme tokens| THEME
    AUTHUI -.->|theme tokens| THEME

