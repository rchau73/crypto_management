    style LAYOUT fill:#1e293b,stroke:#93c5fd,color:#e5e7eb
    style TABS fill:#1e293b,stroke:#86efac,color:#e5e7eb
    style SHARED fill:#1e293b,stroke:#f0abfc,color:#e5e7eb
    style HOOKS fill:#1e293b,stroke:#fca5a5,color:#e5e7eb
    style UTILS fill:#1e293b,stroke:#67e8f9,color:#e5e7eb
    style API fill:#1e293b,stroke:#fdba74,color:#e5e7eb
