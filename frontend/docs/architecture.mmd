flowchart TD
    subgraph APP["App.jsx — composition root"]
        ROOT["Renders LoginPage while logged out,\nDashboard (tab & filter state) once logged in"]
    end

    subgraph AUTHUI["Auth UI"]
        LOGIN["LoginPage\n(full-page swap when logged out)"]
    end

    subgraph LAYOUT["Layout components"]
        HEADER["AppHeader (sticky)\n+ ActionsBar + Log Out"]
        STATS["StatTiles"]
        STATUS["StatusLine"]
        FILTERS["FiltersBar\n(active-filter chips)"]
        EMPTY["EmptyState"]
    end

    subgraph TABS["components/tabs/ — one per Tab"]
        T0["PerAssetTab"]
        T1["PerAssetTotalTab"]
        T2["PerGroupTab"]
        T3["BarcaActualTab"]
        T4["DashboardTab"]
        T5["AdminTab\n(role === admin only)"]
    end

    subgraph SHARED["Shared UI components"]
        SORTHEAD["SortableTableHead"]
        PAGI["PaginationControls"]
        BADGE["DeviationBadge\n(status dot + text)"]
        PIE["AllocationPieChart"]
        LINE["HistoryLineChart"]
        TOOLTIP["ChartTooltip"]
        DCTRL["DashboardControls"]
    end

    subgraph HOOKS["hooks/ — state & data fetching"]
        HAUTH["useAuth\n(session check, login, logout)"]
        HALLOC["useAllocations"]
        HHIST["useHistoryDashboard"]
        HUSERS["useUsers\n(admin CRUD)"]
        HSORT["useSortableData"]
        HPAGE["usePagination"]
    end

    subgraph UTILS["utils/ — pure functions (unit tested)"]
        FMT["formatters.js"]
        MATH["allocationMath.js"]
        BUCKET["historyBucketing.js"]
    end

    subgraph API["api/client.js"]
        CLIENT["fetchAllocations() · fetchHistory() · importWallets()\nlogin() · logout() · fetchCurrentUser()\nfetchUsers() · createUser() · updateUser() · deleteUser()\n(every call: credentials: include + silent refresh-on-401)"]
    end

    THEME["theme.js\ndarkTheme · COLORS · colorForSeries"]
    BACKEND[("Rust backend\nGET/POST /api/*")]

    ROOT -->|owns| HAUTH
    ROOT -->|logged out| LOGIN
    ROOT -->|logged in| HEADER
    ROOT --> STATS
    ROOT --> STATUS
    ROOT --> FILTERS
    ROOT --> EMPTY
    ROOT --> T0
    ROOT --> T1
    ROOT --> T2
    ROOT --> T3
    ROOT --> T4
    ROOT -->|role === admin| T5
    ROOT -->|owns| HALLOC

    LOGIN -->|calls| HAUTH
    T5 -->|owns| HUSERS

    TABS --> SHARED
    TABS --> HOOKS
    TABS --> UTILS
    HOOKS --> CLIENT
    CLIENT --> BACKEND
    TABS -.->|theme tokens| THEME
    SHARED -.->|theme tokens| THEME
    AUTHUI -.->|theme tokens| THEME

